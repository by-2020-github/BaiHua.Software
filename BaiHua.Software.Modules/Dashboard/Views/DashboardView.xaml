<UserControl x:Class="BaiHua.Software.Modules.Dashboard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Background="White" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" Foreground="#6B7280"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="刷新数据" Command="{Binding RefreshCommand}" Padding="16,8" Margin="16,0,0,0"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding LastRefreshTime, StringFormat=最近刷新：{0:yyyy-MM-dd HH:mm:ss}}" Margin="0,16,0,16" Foreground="#6B7280"/>

        <UniformGrid Grid.Row="2" Columns="2" Rows="2">
            <Border Margin="0,0,12,12" Padding="18" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="在线设备" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding OnlineDeviceCount}" FontSize="28" FontWeight="Bold" Foreground="#16A34A" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,12" Padding="18" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="离线设备" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding OfflineDeviceCount}" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="18" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="今日产量" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding TodayOutput}" FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Padding="18" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="良率" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding YieldRate, StringFormat={}{0:F1}%}" FontSize="28" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
