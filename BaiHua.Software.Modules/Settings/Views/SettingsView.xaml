<UserControl x:Class="BaiHua.Software.Modules.Settings.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Background="White" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="#1F2937"/>
            <TextBlock Text="维护应用启动、主题、语言和日志参数。" Margin="0,6,0,0" Foreground="#6B7280"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,16,0" Padding="18" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="系统名称" VerticalAlignment="Center" Margin="0,0,16,12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="设备编号" VerticalAlignment="Center" Margin="0,0,16,12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="语言" VerticalAlignment="Center" Margin="0,0,16,12"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="主题" VerticalAlignment="Center" Margin="0,0,16,12"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Margin="0,0,0,12"/>

                    <CheckBox Grid.Row="4" Grid.Column="1" Content="应用启动后自动运行" IsChecked="{Binding AutoStart}" Margin="0,0,0,12"/>
                    <CheckBox Grid.Row="5" Grid.Column="1" Content="启用操作日志并自动重连设备" IsChecked="{Binding EnableOperationLog}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Padding="16" Margin="0,0,0,12" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="运行概览" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding RuntimeSummary}" Margin="0,10,0,0" Foreground="#2563EB" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding InterfaceSummary}" Margin="0,8,0,0" Foreground="#2563EB" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PersistenceSummary}" Margin="0,8,0,0" Foreground="#2563EB" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Padding="16" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="配置预览" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding PreviewItems}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="{Binding}" Foreground="#374151" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#6B7280" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="保存设置" Command="{Binding SaveCommand}" Padding="16,8"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
